{
  "homepage": ".",
  "name": "memory-card-quest",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "create-react-app": "^3.1.1",
    "react": "^16.8.6",
    "react-dom": "^16.8.6",
    "react-redux": "^7.1.0",
    "react-scripts": "3.0.1",
    "redux": "^4.0.4"
  },
  "scripts": {
    "start": "set SKIP_PREFLIGHT_CHECK=true&& set NODE_OPTIONS=--openssl-legacy-provider&& react-scripts start",
    "build": "set SKIP_PREFLIGHT_CHECK=true&& set NODE_OPTIONS=--openssl-legacy-provider&& react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "meta": "node scripts/generate-project-meta.mjs",
    "meta:check": "node scripts/generate-project-meta.mjs --check",
    "shots": "node scripts/capture-project-shots.mjs",
    "social": "node scripts/generate-social-preview.mjs",
    "social:check": "node scripts/generate-social-preview.mjs --check",
    "icons": "node scripts/generate-app-icons.mjs",
    "icons:check": "node scripts/generate-app-icons.mjs --check",
    "meta:refresh": "node scripts/refresh-project-meta.mjs",
    "trailers": "node scripts/build-project-trailers.mjs",
    "trailers:check": "node scripts/build-project-trailers.mjs --check"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^2.1.1"
  }
}
